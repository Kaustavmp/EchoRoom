# EchoRoom – Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: Google account for Meet (improves bot admission) ────────────
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# ── Optional: Hugging Face token for speaker diarization ─────────────────
# Register at https://huggingface.co and accept pyannote model terms.
HF_TOKEN=

# ── Optional: LLM model overrides ────────────────────────────────────────
# Default live analysis model (fast, cheap)
ECHOROOM_LIVE_MODEL=gpt-4o-mini
# Default report generation model (more thorough)
ECHOROOM_REPORT_MODEL=gpt-4o

# ── Optional: Whisper model (tiny|base|small|medium|large) ───────────────
ECHOROOM_WHISPER_MODEL=base

# ── Optional: Redis URL (for multi-worker session sharing) ───────────────
REDIS_URL=redis://localhost:6379/0

# ── Optional: Recall.ai (drop-in alternative joining layer) ──────────────
# https://www.recall.ai – sign up for an API key
RECALL_API_KEY=
